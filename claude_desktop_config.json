{
  "mcpServers": {
    "illumio": {
      "command": "/bin/bash",
      "args": ["/full/path/to/illumio_mcp.sh"],
      "env": {
        "ILLUMIO_PCE_HOST": "pce.company.com",
        "ILLUMIO_PCE_PORT": "8443",
        "ILLUMIO_ORG_ID": "1",
        "ILLUMIO_API_KEY_USER": "api_1234567890abcdef",
        "ILLUMIO_API_KEY_SECRET": "your_api_secret_key_here",
        "ILLUMIO_INSECURE_TLS": "false"
      }
    }
  }
}
